<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dsaBg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/bt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/dsaText"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/bt_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="加载日K数据…"
        android:textColor="?attr/dsaPrimary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bt_s1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="10dp"
            android:text="MA金叉"
            android:textColor="?attr/dsaText2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bt_s2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="10dp"
            android:text="MACD金叉"
            android:textColor="?attr/dsaText2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bt_s3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="10dp"
            android:text="RSI超卖"
            android:textColor="?attr/dsaText2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bt_s4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="10dp"
            android:text="买入持有"
            android:textColor="?attr/dsaText2"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/bt_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:padding="14dp"
        android:text="选择策略开始回测"
        android:textColor="?attr/dsaText"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:id="@+id/bt_trades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
