<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dsaBg">

    <!-- v2.12.63：液态玻璃氛围光晕层（最底层，主色径向光斑；纯视觉，不影响页面内容与交互） -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/ambientLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- v2.12.7：ViewPager2 承载四个页签，左右拖动时相邻页与当前页同屏联动平移。
         v2.12.14：pager 铺满全屏，dock 悬浮叠加在底部，页面内容可延伸到 dock 后方被玻璃透出 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- v2.12.4：悬浮式玻璃底栏（左右留白 + 全圆角胶囊 + 亮边）；v2.12.18 内层选中项为磨砂玻璃胶囊，随拖动实时平移。
         后方透出与模糊/折射全部由 Compose 液态玻璃层承担 -->
    <FrameLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp">

        <!-- v2.12.13：液态玻璃外壳（Compose 背景层，胶囊/图标/点击逻辑不变） -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/dock_glass"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/dock_pill"
            android:layout_width="70dp"
            android:layout_height="34dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_dock_glass_pill" />

        <LinearLayout
            android:id="@+id/dock_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/dock_item_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/dock_icon_0"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/tab_watchlist"
                        android:src="@drawable/ic_tab_watch" />

                    <TextView
                        android:id="@+id/dock_label_0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:singleLine="true"
                        android:text="@string/tab_watchlist"
                        android:textColor="?attr/dsaText2"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/dock_item_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/dock_icon_1"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/tab_market"
                        android:src="@drawable/ic_tab_market" />

                    <TextView
                        android:id="@+id/dock_label_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:singleLine="true"
                        android:text="@string/tab_market"
                        android:textColor="?attr/dsaText2"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/dock_item_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/dock_icon_2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/tab_screen"
                        android:src="@drawable/ic_tab_screen" />

                    <TextView
                        android:id="@+id/dock_label_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:singleLine="true"
                        android:text="@string/tab_screen"
                        android:textColor="?attr/dsaText2"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/dock_item_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/dock_icon_3"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/tab_mine"
                        android:src="@drawable/ic_tab_mine" />

                    <TextView
                        android:id="@+id/dock_label_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:singleLine="true"
                        android:text="@string/tab_mine"
                        android:textColor="?attr/dsaText2"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- v2.12.11：全局宠物悬浮层（外观设置开启「全局显示」后挂入，避开底部 dock） -->
    <FrameLayout
        android:id="@+id/mascot_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
