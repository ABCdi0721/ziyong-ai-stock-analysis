<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- v2.9.6 搜索 / 时间筛选 / 排序 工具条 -->
    <LinearLayout
        android:id="@+id/h_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/dsaCard"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/h_search"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_card"
            android:hint="搜索股票名称或代码"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="?attr/dsaText"
            android:textColorHint="?attr/dsaText2"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/h_sp_time"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1" />

            <Spinner
                android:id="@+id/h_sp_sort"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />

            <Spinner
                android:id="@+id/h_sp_order"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/h_result_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="?attr/dsaText2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/h_btn_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="检测报错"
                android:textColor="?attr/dsaPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="72dp" />

        <TextView
            android:id="@+id/history_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="暂无历史报告，去自选页生成一份吧"
            android:textColor="?attr/dsaText2"
            android:textSize="14sp" />

        <!-- 多选操作栏 -->
        <LinearLayout
            android:id="@+id/history_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom"
            android:background="?attr/dsaCard"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/h_select_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全选"
                android:textColor="?attr/dsaText"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/h_selected_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="已选 0 条"
                android:textColor="?attr/dsaText2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/h_btn_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="删除"
                android:textColor="?attr/dsaPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/h_btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:padding="10dp"
                android:text="取消"
                android:textColor="?attr/dsaText2"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
