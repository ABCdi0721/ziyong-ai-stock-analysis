<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============ v2.8.0 主题系统 ============
         结构：Theme.Dsa.Base（浅色模板）→ Theme.Dsa.X（预设色）
              Theme.Dsa.Base.Dark（深色模板）→ Theme.Dsa.X.Dark
         运行时 ThemeManager 按 Prefs 选择并 setTheme，全局生效 -->
    <!-- ============ v2.8.1 Material Design 3 风格 ============
         参考 legado-with-MD3：tonal container 色板、NavigationBar pill 高亮、
         16dp 大圆角 FAB、28dp 对话框、粗体大标题 -->
    <style name="Theme.Dsa.Base" parent="Theme.MaterialComponents.Light">
        <item name="colorPrimary">@color/theme_blue</item>
        <item name="colorPrimaryVariant">@color/theme_blue_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/theme_blue</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorControlActivated">@color/theme_blue</item>
        <item name="colorPrimaryContainer">@color/soft_blue</item>
        <item name="colorOnPrimaryContainer">@color/theme_blue_dark</item>
        <item name="colorSecondaryContainer">@color/soft_blue</item>
        <item name="colorSurface">@color/light_card</item>
        <item name="colorOnSurface">@color/light_text</item>
        <item name="colorOnSurfaceVariant">@color/light_text2</item>
        <item name="dsaPrimary">@color/theme_blue</item>
        <item name="dsaPrimaryDark">@color/theme_blue_dark</item>
        <item name="dsaOnPrimary">#FFFFFF</item>
        <item name="dsaPrimarySoft">@color/soft_blue</item>
        <!-- v2.12.4：原生控件（Spinner/下拉/菜单）文字色跟随主题，避免深色底上黑字不可读 -->
        <item name="android:textColorPrimary">@color/light_text</item>
        <item name="android:textColorSecondary">@color/light_text2</item>
        <item name="dsaBg">@color/light_bg</item>
        <item name="dsaCard">@color/light_card</item>
        <item name="dsaSurface2">@color/light_surface2</item>
        <item name="dsaText">@color/light_text</item>
        <item name="dsaText2">@color/light_text2</item>
        <item name="dsaDivider">@color/light_divider</item>
        <!-- v2.12.4 玻璃图层 -->
        <item name="dsaGlassTint">@color/glass_tint_light</item>
        <item name="dsaGlassStroke">@color/glass_stroke_light</item>
        <item name="dsaGlassHi">@color/glass_hi_light</item>
        <item name="dsaNavBg">@color/nav_glass_light</item>
        <item name="android:statusBarColor">@color/light_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:actionBarSize">42dp</item>
        <item name="actionBarStyle">@style/Widget.Dsa.ActionBar</item>
        <item name="android:actionBarStyle">@style/Widget.Dsa.ActionBar</item>
        <item name="materialButtonStyle">@style/Widget.Dsa.Button</item>
        <item name="floatingActionButtonStyle">@style/Widget.Dsa.Fab</item>
        <item name="bottomNavigationStyle">@style/Widget.Dsa.BottomNav</item>
        <item name="materialAlertDialogTheme">@style/Widget.Dsa.AlertDialog</item>
    </style>

    <style name="Theme.Dsa.Base.Dark" parent="Theme.MaterialComponents">
        <item name="colorPrimary">@color/theme_blue</item>
        <item name="colorPrimaryVariant">@color/theme_blue_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/theme_blue</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorControlActivated">@color/theme_blue</item>
        <item name="colorPrimaryContainer">@color/dark_soft</item>
        <item name="colorOnPrimaryContainer">@color/theme_blue</item>
        <item name="colorSecondaryContainer">@color/dark_soft</item>
        <item name="colorSurface">@color/dark_card</item>
        <item name="colorOnSurface">@color/dark_text</item>
        <item name="colorOnSurfaceVariant">@color/dark_text2</item>
        <item name="dsaPrimary">@color/theme_blue</item>
        <item name="dsaPrimaryDark">@color/theme_blue_dark</item>
        <item name="dsaOnPrimary">#FFFFFF</item>
        <item name="dsaPrimarySoft">@color/dark_soft</item>
        <!-- v2.12.4：原生控件（Spinner/下拉/菜单）文字色跟随主题，避免深色底上黑字不可读 -->
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:textColorSecondary">@color/dark_text2</item>
        <item name="dsaBg">@color/dark_bg</item>
        <item name="dsaCard">@color/dark_card</item>
        <item name="dsaSurface2">@color/dark_surface2</item>
        <item name="dsaText">@color/dark_text</item>
        <item name="dsaText2">@color/dark_text2</item>
        <item name="dsaDivider">@color/dark_divider</item>
        <!-- v2.12.4 玻璃图层 -->
        <item name="dsaGlassTint">@color/glass_tint_dark</item>
        <item name="dsaGlassStroke">@color/glass_stroke_dark</item>
        <item name="dsaGlassHi">@color/glass_hi_dark</item>
        <item name="dsaNavBg">@color/nav_glass_dark</item>
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:actionBarSize">42dp</item>
        <item name="actionBarStyle">@style/Widget.Dsa.ActionBar.Dark</item>
        <item name="android:actionBarStyle">@style/Widget.Dsa.ActionBar.Dark</item>
        <item name="materialButtonStyle">@style/Widget.Dsa.Button</item>
        <item name="floatingActionButtonStyle">@style/Widget.Dsa.Fab.Dark</item>
        <item name="bottomNavigationStyle">@style/Widget.Dsa.BottomNav.Dark</item>
        <item name="materialAlertDialogTheme">@style/Widget.Dsa.AlertDialog.Dark</item>
    </style>

