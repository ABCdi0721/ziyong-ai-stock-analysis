    <!-- 组件样式（v2.8.1 MD3） -->
    <style name="Widget.Dsa.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Dsa.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@drawable/bottom_nav_color</item>
        <item name="itemTextColor">@drawable/bottom_nav_color</item>
        <item name="itemRippleColor">@color/light_surface2</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Dsa.NavIndicator</item>
        <item name="android:background">@drawable/bg_nav_glass</item>
        <item name="elevation">0dp</item>
        <item name="backgroundTint">@null</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Dsa.NavActive</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Dsa.NavInactive</item>
    </style>
    <style name="Widget.Dsa.BottomNav.Dark" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@drawable/bottom_nav_color</item>
        <item name="itemTextColor">@drawable/bottom_nav_color</item>
        <item name="itemRippleColor">@color/dark_surface2</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Dsa.NavIndicator.Dark</item>
        <item name="android:background">@drawable/bg_nav_glass</item>
        <item name="elevation">0dp</item>
        <item name="backgroundTint">@null</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Dsa.NavActive</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Dsa.NavInactive</item>
    </style>

    <!-- MD3 NavigationBar 选中 pill（v2.12.4：饱和主色胶囊 + 白图标/白字） -->
    <style name="Widget.Dsa.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/dsaPrimary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Dsa.NavPill</item>
        <item name="marginHorizontal">6dp</item>
    </style>
    <style name="Widget.Dsa.NavIndicator.Dark" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/dsaPrimary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Dsa.NavPill</item>
        <item name="marginHorizontal">6dp</item>
    </style>
    <style name="ShapeAppearance.Dsa.NavPill" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">100dp</item>
    </style>
    <style name="TextAppearance.Dsa.NavActive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/dsaOnPrimary</item>
    </style>
    <style name="TextAppearance.Dsa.NavInactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/dsaText2</item>
    </style>

    <!-- MD3 大圆角 FAB（16dp，主色底） -->
    <style name="Widget.Dsa.Fab" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">?attr/dsaPrimary</item>
        <item name="tint">@color/light_card</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Dsa.Fab</item>
    </style>
    <style name="Widget.Dsa.Fab.Dark" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">?attr/dsaPrimary</item>
        <item name="tint">@color/dark_text</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Dsa.Fab</item>
    </style>

    <!-- MD3 对话框（28dp 大圆角） -->
    <style name="Widget.Dsa.AlertDialog" parent="MaterialAlertDialog.MaterialComponents">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Dsa.Dialog</item>
        <item name="backgroundTint">?attr/dsaCard</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Dsa.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Dsa.DialogButton</item>
    </style>
    <style name="Widget.Dsa.AlertDialog.Dark" parent="MaterialAlertDialog.MaterialComponents">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Dsa.Dialog</item>
        <item name="backgroundTint">?attr/dsaCard</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Dsa.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Dsa.DialogButton</item>
    </style>
    <style name="Widget.Dsa.DialogButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/dsaPrimary</item>
    </style>

    <!-- MD3 形状系统 -->
    <style name="ShapeAppearance.Dsa.Pill" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeAppearance.Dsa.Fab" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.Dsa.Dialog" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Widget.Dsa.ActionBar" parent="Widget.AppCompat.Light.ActionBar">
        <item name="background">@color/light_bg</item>
        <item name="titleTextColor">@color/light_text</item>
        <item name="android:background">@color/light_bg</item>
        <item name="android:titleTextColor">@color/light_text</item>
        <item name="titleTextStyle">@style/Widget.Dsa.ActionBarTitle</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Widget.Dsa.ActionBar.Dark" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/dark_bg</item>
        <item name="titleTextColor">@color/dark_text</item>
        <item name="android:background">@color/dark_bg</item>
        <item name="android:titleTextColor">@color/dark_text</item>
        <item name="titleTextStyle">@style/Widget.Dsa.ActionBarTitle</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Dsa.ActionBarTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="Widget.Dsa.ActionBarTitle.Dark" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dark_text</item>
    </style>

    <!-- 兼容旧引用：Theme.DsaMobile 保留为默认蓝白浅色主题别名 -->
    <style name="Theme.DsaMobile" parent="Theme.Dsa.Blue" />
</resources>
