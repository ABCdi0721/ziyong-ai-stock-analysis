<?xml version="1.0" encoding="utf-8"?>
<!-- v2.12.8 异动提醒内容块（深色主题下接近图1 的深色块，浅色主题下为浅灰块） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/dsaSurface2" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="?attr/dsaGlassHi"
                android:endColor="#00000000"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="?attr/dsaGlassStroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
