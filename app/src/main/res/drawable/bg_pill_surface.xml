<?xml version="1.0" encoding="utf-8"?>
<!-- v2.12.13 状态胶囊玻璃：surface2 半透底 + 玻璃叠层 + 顶部高光 + 亮边；整体透明度跟随标签透明度设置 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/dsaSurface2" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/dsaGlassTint" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="?attr/dsaGlassHi"
                android:endColor="#00000000"
                android:type="linear" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="?attr/dsaGlassStroke" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</layer-list>
