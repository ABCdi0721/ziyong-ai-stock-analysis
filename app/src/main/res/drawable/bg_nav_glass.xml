<?xml version="1.0" encoding="utf-8"?>
<!-- v2.12.13 悬浮底部导航：半透明玻璃底 + 顶部高光 + 1dp 亮边 + 26dp 圆角（Compose 玻璃层兜底静态底） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/dsaNavBg" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="?attr/dsaGlassHi"
                android:endColor="#00000000"
                android:type="linear" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="?attr/dsaGlassStroke" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
